<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ApplicationIcon>ExpressApp.ico</ApplicationIcon>
    <Deterministic>false</Deterministic>
    <OutputPath>..\..\..\..\..\bin\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Disable static web assets (brought in transitively by DevExpress Blazor/Dashboard packages).
         Prevents "The target StaticWebAssetsPrepareForRun does not exist" during dotnet publish
         for this pure WinForms XAF host. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!-- Stub the target that DevExpress static web asset packages (via Microsoft.NET.Sdk.StaticWebAssets)
       inject into PrepareForRunDependsOn. This project is WinForms-only; we don't need web assets. -->
  <Target Name="StaticWebAssetsPrepareForRun" />

  <!-- The Microsoft.AspNetCore.Components.WebView.WindowsForms package (transitively referenced by DevExpress)
       adds targets that are triggered on FileSystem publish (because of PublishProtocol in the pubxml).
       These targets call tasks like ComputeStaticWebAssetsTargetPaths which are not available
       (and not needed) for a pure desktop XAF ModelEditor host. Stub them to allow publish to succeed. -->
  <Target Name="AddStaticWebAssetsForAppXBundle" />
  <Target Name="AddStaticWebAssetsForClickOnce" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;CA1416;XAF0017</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;CA1416;XAF0017</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Model.xafml" />
    <None Remove="Images\Logo.svg" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\..\src\Common\AssemblyInfoVersion.cs" Link="Properties\AssemblyInfoVersion.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Model.xafml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Images\Logo.svg" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.ExpressApp"  />
    <PackageReference Include="DevExpress.ExpressApp.Win" />
    <PackageReference Include="DevExpress.ExpressApp.Win.All"/>
    <PackageReference Include="DevExpress.ExpressApp.Xpo"  />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Xpand.XAF.ModelEditor.Module.Win\Xpand.XAF.ModelEditor.Module.Win.csproj">
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>
</Project>